<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Write the OpenAPI document to Api/openapi.json on every build; it is committed as the API contract. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The generator only re-runs when Api.dll changes; clear its cache when the document is missing so a build always writes it. -->
  <Target Name="RegenerateMissingOpenApiDocument" BeforeTargets="GenerateOpenApiDocuments" Condition="!Exists('$(OpenApiDocumentsDirectory)/openapi.json')">
    <Delete Files="$(_OpenApiDocumentsCache)" />
  </Target>

</Project>
